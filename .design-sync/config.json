{
  "projectId": "b683a5a6-eea2-4cf5-af15-f848f9415a4f",
  "shape": "storybook",
  "readmeHeader": ".design-sync/conventions.md",
  "pkg": "@insession/design-system",
  "entry": "src/index.ts",
  "buildCmd": "pnpm build",
  "storybookStatic": ".design-sync/sb-reference",
  "storybookConfigDir": ".storybook",
  "extraEntries": ["./.design-sync/ds-surface.tsx"],
  "provider": { "component": "DsSurface" },
  "extraFonts": [
    "./node_modules/@fontsource/jetbrains-mono/400.css",
    "./node_modules/@fontsource/jetbrains-mono/700.css"
  ],
  "overrides": {
    "Avatar": { "cardMode": "column" },
    "Icon": { "viewport": "900x2000" },
    "PageLayout": { "cardMode": "single" },
    "RingTimer": { "cardMode": "single", "primaryStory": "Normal" },
    "Tabs": { "cardMode": "column" }
  },
  "titleMap": {
    "Navigation": null,
    "Elevation": null,
    "Segmented&Slider": "SegmentedControl",
    "Upload&Color": "UploadTile",
    "Status": "StatusBadge",
    "Icons": "Icon",
    "Controls": "Checkbox",
    "Primitives": "Avatar",
    "Colors": null,
    "Tokens": null,
    "Typography": null
  }
}
