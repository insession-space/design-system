{
  "name": "@insession/design-system",
  "version": "1.3.1",
  "description": "InSession / loophub 共通のデザインシステム。純粋 leaf UI プリミティブ + デザイントークン（アプリ依存なし。i18n 等は props で注入する）",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insession-space/design-system.git"
  },
  "//": "ビルド成果物(dist)を配布する。theme.css はパッケージ直下に置いたまま ./theme.css として公開する(tsup は CSS を処理しないため)。react はホストと同一インスタンスを使うため peerDependency。",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "theme.css",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "//publishConfig": "registry を明示するのは必須。開発機の ~/.npmrc が社内プロキシ(npm.flatt.tech 等)を registry に設定している場合、これが無いと npm publish がプロキシ宛になり公開レジストリへ出ない。",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "biome check .",
    "format": "biome format --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/cli": "^2.31.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.12.1"
}
